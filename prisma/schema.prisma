generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id               String             @id @default(uuid())
  name             String             @unique
  description      String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  rolesPermissions RolesPermissions[]
  users            User[]

  @@map("roles")
}

model Permission {
  id               String             @id @default(uuid())
  path             String
  method           Method
  description      String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  default          Boolean            @default(false)
  rolesPermissions RolesPermissions[]

  @@unique([path, method])
  @@index([path, method])
  @@map("permissions")
}

model RolesPermissions {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId, permissionId])
  @@map("roles_permissions")
}

model Customer {
  id        String    @id @default(uuid())
  name      String?
  phone     String    @unique
  address   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  sales     Sale[]

  @@map("customers")
}

model Supplier {
  id          String     @id @default(uuid())
  name        String
  phone       String     @unique
  address     String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  bankAccount String?
  bankName    String?
  purchases   Purchase[]

  @@map("suppliers")
}

model Purchase {
  id            String         @id @default(uuid())
  purchaseDate  DateTime       @map("purchase_date")
  totalAmount   Float          @map("total_amount")
  note          String?        @map("note")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  supplierId    String
  averageWeight Float          @map("average_weight")
  cagesCount    Int            @map("cages_count")
  cagesWeight   Float          @map("cages_weight")
  purchaseItems PurchaseItem[]
  supplier      Supplier       @relation(fields: [supplierId], references: [id])

  @@map("purchases")
}

model PurchaseItem {
  id               String    @id @default(uuid())
  quantity         Float     @map("quantity")
  quantityUnit     String    @map("quantity_unit")
  unitPrice        Float     @map("unit_price")
  amount           Float     @map("amount")
  note             String?   @map("note")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  purchaseId       String
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  purchase         Purchase  @relation(fields: [purchaseId], references: [id])

  @@map("purchase_items")
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  products  Product[]

  @@map("product_categories")
}

model Product {
  id                    String                 @id @default(uuid())
  name                  String
  type                  ProductType            @map("type")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  categoryId            String
  inventoryTransactions InventoryTransaction[]
  category              ProductCategory        @relation(fields: [categoryId], references: [id])
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]

  @@map("products")
}

model InventoryTransaction {
  id              String                        @id @default(uuid())
  transactionDate DateTime                      @map("transaction_date")
  refType         InventoryTransactionType      @map("ref_type")
  refId           String                        @map("ref_id")
  direction       InventoryTransactionDirection
  quantity        Float
  quantityUnit    String                        @map("quantity_unit")
  unitCost        Float                         @map("unit_cost")
  totalCost       Float                         @map("total_cost")
  note            String?
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  productId       String
  product         Product                       @relation(fields: [productId], references: [id])

  @@map("inventory_transactions")
}

model Sale {
  id              String     @id @default(uuid())
  saleDate        DateTime   @map("sale_date")
  subtotalAmount  Float      @map("subtotal_amount")
  discountAmount  Float      @map("discount_amount")
  finalAmount     Float      @map("final_amount")
  paidAmount      Float      @map("paid_amount")
  remainingAmount Float      @map("remaining_amount")
  status          SaleStatus @map("status")
  note            String?    @map("note")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")
  customerId      String     @map("customer_id")
  saleItems       SaleItem[]
  customer        Customer   @relation(fields: [customerId], references: [id])

  @@map("sales")
}

model SaleItem {
  id           String    @id @default(uuid())
  quantity     Float     @map("quantity")
  quantityUnit String    @map("quantity_unit")
  unitPrice    Float     @map("unit_price")
  amount       Float     @map("amount")
  costAmount   Float     @map("cost_amount")
  profitAmount Float     @map("profit_amount")
  note         String?   @map("note")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  saleId       String    @map("sale_id")
  productId    String    @map("product_id")
  product      Product   @relation(fields: [productId], references: [id])
  sale         Sale      @relation(fields: [saleId], references: [id])

  @@map("sale_items")
}

enum SaleStatus {
  PENDING
  PAID
  CANCELLED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
  OTHER
}

enum InventoryTransactionDirection {
  IN
  OUT
}

enum ProductType {
  LIVE
  PROCESSED
  PART
}

enum Method {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}
